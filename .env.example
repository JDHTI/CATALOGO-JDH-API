# =============================================================================
# APLICACIÓN
# =============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# =============================================================================
# PUERTOS PUBLICADOS POR COMPOSE (host)
# Si cambias uno, ajusta también DATABASE_URL / REDIS_PORT / S3_ENDPOINT.
# =============================================================================
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6380
REDIS_COMMANDER_HOST_PORT=8081
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# 8080 por defecto: coincide con NEXT_PUBLIC_API_URL de jdh-catalogo-ui.
API_HOST_PORT=8080

# =============================================================================
# AUTENTICACIÓN (solo /favorites; el resto del catálogo es público) — OPCIONAL
#
# Esta API no emite tokens ni toca la base `jdh_auth`: solo VERIFICA el JWT
# EdDSA que firma jdh-catalogo-ui, descargando su clave pública del JWKS.
# Con AUTH_JWKS_URL vacía la API arranca igual y /favorites responde 503.
# Ver docs/favoritos.md.
# =============================================================================
# Origen de la UI DEL MISMO ENTORNO + /api/auth/jwks. No se deriva del issuer.
# 3111 es el puerto en el que jdh-catalogo-ui se levanta para pruebas locales;
# ajústalo si tu instancia usa otro.
AUTH_JWKS_URL=http://localhost:3111/api/auth/jwks

# Identificadores lógicos del contrato del token; cámbialos solo si la UI lo
# hace. La audiencia SE VERIFICA: sin ella, un token emitido para otro
# consumidor valdría aquí.
AUTH_JWT_ISSUER=jdh-catalogo-ui
AUTH_JWT_AUDIENCE=jdh-catalogo-api

# =============================================================================
# BASE DE DATOS PROPIA DEL CATÁLOGO (Prisma)
# Credenciales alineadas con docker/env/postgres.env
# =============================================================================
DATABASE_URL="postgresql://jdh_catalogo:8ZzeK9E64Gj6RC7qhZHYfMJ7@localhost:5435/jdh_catalogo?schema=public"
DATABASE_LOG_QUERIES=false

# =============================================================================
# REDIS (caché)
# Credenciales alineadas con docker/env/redis.env
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=d2mcKaUDew2AP3obapjHoa6d
REDIS_DB=0
REDIS_KEY_PREFIX=jdh:catalogo:
REDIS_DEFAULT_TTL=300

# =============================================================================
# ALMACENAMIENTO S3 / MinIO
# Credenciales alineadas con docker/env/minio.env
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jdh-catalogo
S3_ACCESS_KEY_ID=jdh_catalogo
S3_SECRET_ACCESS_KEY=Qa3v8aCuiBbuEKD6kK2iCA6B
# MinIO requiere path-style addressing
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/jdh-catalogo

# ——— Producción: Cloudflare R2 (S3-compatible, egress $0) ———
# StorageService no cambia: solo reemplaza el bloque de arriba por este.
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=jdh-catalogo
# S3_ACCESS_KEY_ID=<R2 API token>
# S3_SECRET_ACCESS_KEY=<R2 API token secret>
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://cdn.jdh.com.co
# (bucket privado + Custom Domain público apuntando a S3_PUBLIC_URL; los
# tokens de escritura solo los usa `pnpm images:ingest`, nunca la API)

# =============================================================================
# DATAWAREHOUSE (Postgres externo) — OPCIONAL
#
# No se levanta en compose y no es necesario para arrancar la API: solo se usa
# para importar/sincronizar datos. Con DWH_HOST vacío la conexión queda
# deshabilitada y /health lo reporta como "disabled".
# Rellena estas cuatro para habilitarla:
# =============================================================================
DWH_HOST=
DWH_PORT=5432
DWH_DATABASE=
DWH_USER=
DWH_PASSWORD=

# Ajustes opcionales de la conexión al DWH (valores por defecto)
DWH_SCHEMA=public
DWH_SSL=false
DWH_POOL_MAX=10
DWH_POOL_IDLE_TIMEOUT=30000
DWH_CONNECTION_TIMEOUT=10000
DWH_STATEMENT_TIMEOUT=60000

# =============================================================================
# PUBLICACIÓN DEL CATÁLOGO -> INSTANCIA DESPLEGADA (Railway) — OPCIONAL
#
# Solo la define el equipo LOCAL, que es el único con acceso al DWH. Con esta
# variable vacía, `pnpm push:catalogo` se niega a correr y nada más cambia.
# NUNCA se define en la API desplegada: allá no existe una "segunda base".
#
# El valor es la cadena PÚBLICA de la base de Railway (Postgres -> Variables ->
# DATABASE_PUBLIC_URL), que sale por su proxy TCP. Ver docs/catalog-push.md.
# =============================================================================
PUSH_TARGET_DATABASE_URL=

# Ajustes opcionales de la publicación (valores por defecto)
PUSH_BATCH_SIZE=1000
PUSH_CONNECTION_TIMEOUT=20000
PUSH_STATEMENT_TIMEOUT=120000

# =============================================================================
# RATE LIMITING (por IP, sobre Redis)
# =============================================================================
# Ventana en segundos y máximo de peticiones por IP dentro de la ventana.
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =============================================================================
# SINCRONIZACION DWH -> CATALOGO
# =============================================================================
# Cron de la sincronizacion de productos (por defecto: 02:00 todos los dias).
SYNC_PRODUCTS_CRON=0 2 * * *
SYNC_PRODUCTS_ENABLED=true
