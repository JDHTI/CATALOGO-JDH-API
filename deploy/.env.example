# Plantilla de deploy/.env (stack de producción, deploy/compose.prod.yaml).
# En el servidor se genera con deploy/scripts/gen-env.sh (secretos aleatorios).
# Valores hex para todo lo que va dentro de una URL (sin caracteres especiales).

# Dominio (registro DNS A → IP del servidor en el DNS interno)
TIENDA_HOST=tienda.jdh.local

# Nombre público (opcional), p. ej. tienda.jdh.com.co. Con valor pasa a ser el
# dominio canónico: BETTER_AUTH_URL, el callback de Entra y NEXT_PUBLIC_SITE_URL
# salen de aquí. /media NO: lo pide siempre el servidor y sigue en TIENDA_HOST
# (CA interna). Caddy le pide certificado público por ACME (la CA
# interna solo firma *.jdh.local), así que el DNS público debe apuntar al
# servidor y los puertos 80/443 llegar a Caddy. TIENDA_HOST sigue sirviéndose
# con la CA interna (lo usa deploy.sh para verificar). Vacío = solo interno.
# Cambiarlo exige `deploy.sh ui` (NEXT_PUBLIC_* van en el bundle).
PUBLIC_HOST=

# Subred fija de la red de compose. TRUST_PROXY de la API la usa para confiar
# en Caddy. Cambiarla solo si choca con otra red del servidor.
DOCKER_SUBNET=172.29.60.0/24

# Ruta del clon de la UI relativa a deploy/ (por defecto, repos hermanos).
# UI_CONTEXT=../../CATALOGO-JDH-UI

# Puertos publicados por Caddy. Solo cambiarlos en máquinas donde 80/443 están
# ocupados (pruebas locales); en el servidor, los valores por defecto.
# HTTP_PORT=80
# HTTPS_PORT=443

# Postgres (superusuario del contenedor). Dos bases en la misma instancia:
# POSTGRES_DB (catálogo, Prisma) y AUTH_DB_NAME (Better Auth, la crea
# docker/postgres/init con el volumen vacío; el nombre es fijo en ese script).
POSTGRES_USER=jdh_catalogo
POSTGRES_PASSWORD=
POSTGRES_DB=jdh_catalogo
AUTH_DB_NAME=jdh_auth

REDIS_PASSWORD=

# RustFS (S3-compatible). Bucket público de lectura vía Caddy /media.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=jdh-catalogo

# Better Auth: firma las sesiones y cifra la clave privada de la tabla jwks.
# Rotarlo exige TRUNCATE TABLE jwks (ver docs/despliegue.md de la UI §4).
BETTER_AUTH_SECRET=

# Entra ID — App Registration del catálogo (ingreso del personal JDH).
# Redirect URI a registrar: https://<PUBLIC_HOST o TIENDA_HOST>/api/auth/callback/microsoft
# La UI exige las tres al arrancar. Mientras no existan, gen-env.sh deja
# valores de relleno: la UI arranca y el ingreso de CLIENTES (email +
# contraseña) funciona; el de Entra no.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# API — límites y sincronización con el DWH (opcional: sin DWH_HOST no hay
# sincronización y /health lo reporta "disabled").
RATE_LIMIT_MAX=300
SYNC_PRODUCTS_ENABLED=false
# Entre comillas: deploy.sh hace `source` de este archivo y el cron lleva espacios.
SYNC_PRODUCTS_CRON="0 2 * * *"
DWH_HOST=
DWH_PORT=5432
DWH_DATABASE=
DWH_USER=
DWH_PASSWORD=
DWH_SCHEMA=public
DWH_SSL=false
