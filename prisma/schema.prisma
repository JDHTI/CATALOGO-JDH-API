// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  // Prisma resuelve includes con JOIN en PostgreSQL y evita viajes por relación.
  previewFeatures = ["relationJoins"]
  provider        = "prisma-client"
  output          = "../generated/prisma"
  // NestJS compila a CommonJS; sin esto el cliente se genera como ESM
  // y falla al ejecutarse desde dist.
  runtime         = "nodejs"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// CATÁLOGO DE PRODUCTOS
//
// Los datos maestros provienen de la vista `consumo.productos` del DWH y se
// sincronizan con un full-extract + upsert idempotente (ver docs/products-sync.md).
// =============================================================================

/// Proveedor del catálogo.
///
/// OJO: "proveedor" aquí es una CLASIFICACIÓN comercial/de mercadeo del ERP
/// (criterio mayor t106), NO una identidad jurídica: no existe NIT ni datos
/// fiscales. Es el criterio de agrupación de productos por proveedor que usa
/// el catálogo (~645 valores distintos).
model Supplier {
  id            Int      @id @default(autoincrement())
  /// Código de la clasificación en el ERP (← cod_proveedor del DWH).
  code          String   @unique
  /// Nombre de la clasificación (← proveedor del DWH).
  name          String
  active        Boolean  @default(true)
  /// Logo comercial: key del objeto en el bucket y URL absoluta servible.
  /// El sync del DWH no los toca; se cargan aparte y quedan null hasta entonces.
  logoObjectKey String?  @map("logo_object_key")
  logoUrl       String?  @map("logo_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("suppliers")
}

/// Fabricante (← fabricante del DWH, texto normalizado con trim).
model Manufacturer {
  id   Int    @id @default(autoincrement())
  name String @unique

  products Product[]

  @@map("manufacturers")
}

/// Marca (← marca del DWH, texto normalizado con trim).
model Brand {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  /// Identificador público para URLs (/marcas/{slug}). Lo asigna el sync con
  /// la política de src/modules/brands/brand-slug.ts; ver docs/brands.md.
  slug          String  @unique
  /// Logo comercial: key del objeto en el bucket y URL absoluta servible.
  /// El sync del DWH no los toca; se cargan aparte y quedan null hasta entonces.
  logoObjectKey String? @map("logo_object_key")
  logoUrl       String? @map("logo_url")

  products Product[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "brands_name_trgm_idx")
  @@map("brands")
}

// =============================================================================
// CATEGORIZACIÓN
//
// Taxonomía de tres niveles (categoría → subcategoría → grupo) y asignación
// producto → grupo en una tabla PROPIA (`product_categorizations`), separada de
// `products`: el sync del DWH nunca la lee ni la escribe, así que sobrevive a
// altas, cambios y activaciones/desactivaciones. Ver docs/categorization.md.
// =============================================================================

/// Categoría del catálogo (primer nivel de la taxonomía).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  /// Identificador público para URLs (/categorias/{slug}).
  slug      String   @unique
  /// Posición en la navegación (ascendente).
  sortOrder Int      @default(0) @map("sort_order")
  /// `false` la oculta de la navegación pública (`GET /categories`); los
  /// productos conservan su asignación.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subcategories   Subcategory[]
  /// Relación heredada: `products.category_id` ya no se usa (la fuente de
  /// verdad es `product_categorizations`).
  products        Product[]
  categorizations ProductCategorization[]

  @@map("categories")
}

/// Subcategoría (segundo nivel), única por nombre dentro de su categoría.
model Subcategory {
  id         Int     @id @default(autoincrement())
  name       String
  slug       String
  categoryId Int     @map("category_id")
  sortOrder  Int     @default(0) @map("sort_order")
  active     Boolean @default(true)

  category        Category                @relation(fields: [categoryId], references: [id])
  groups          ProductGroup[]
  /// Relación heredada, ver `Category.products`.
  products        Product[]
  categorizations ProductCategorization[]

  @@unique([name, categoryId])
  @@unique([slug, categoryId])
  @@map("subcategories")
}

/// Grupo de producto (tercer nivel): el tipo de producto concreto. Es el nivel
/// al que apuntan las reglas de clasificación; la UI pública solo expone
/// categoría y subcategoría.
model ProductGroup {
  id            Int     @id @default(autoincrement())
  name          String
  slug          String
  subcategoryId Int     @map("subcategory_id")
  sortOrder     Int     @default(0) @map("sort_order")
  active        Boolean @default(true)

  subcategory     Subcategory             @relation(fields: [subcategoryId], references: [id])
  categorizations ProductCategorization[]
  rules           CategorizationRule[]

  @@unique([name, subcategoryId])
  @@unique([slug, subcategoryId])
  @@map("product_groups")
}

/// Asignación de un producto a un grupo. Tabla independiente de `products`:
///
/// - Se une por `producto_key` (el hash estable del DWH), no por el id local.
/// - Solo existe fila cuando el producto está clasificado; sin fila = pendiente.
/// - `category_id` / `subcategory_id` repiten la jerarquía del grupo a
///   propósito: son la columna de filtrado del listado público.
/// - `ON DELETE CASCADE`: el sync desactiva productos, nunca los borra; solo una
///   limpieza manual arrastraría la asignación.
model ProductCategorization {
  id          Int    @id @default(autoincrement())
  productoKey String @unique @map("producto_key")

  categoryId    Int @map("category_id")
  subcategoryId Int @map("subcategory_id")
  groupId       Int @map("group_id")

  /// 'propuesta' (carga inicial revisada) | 'regla' (clasificador automático)
  /// | 'manual' (asignada por una persona).
  source      String
  /// 'alta' | 'media' | 'baja'.
  confidence  String
  /// Las asignaciones bloqueadas (las manuales) no las toca ningún proceso
  /// automático, ni aunque el ERP cambie la clasificación del producto.
  locked      Boolean @default(false)
  /// Pendiente de revisión humana (confianza baja o cambio no resuelto).
  needsReview Boolean @default(false) @map("needs_review")
  /// Hash de la clasificación cruda del ERP (línea/sublínea/grupo/tipo) con la
  /// que se decidió. Si cambia, la asignación automática se reevalúa.
  signature   String

  classifiedAt DateTime @default(now()) @map("classified_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product     Product      @relation(fields: [productoKey], references: [productoKey], onDelete: Cascade, onUpdate: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  subcategory Subcategory  @relation(fields: [subcategoryId], references: [id])
  group       ProductGroup @relation(fields: [groupId], references: [id])

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([groupId])
  @@index([needsReview])
  @@map("product_categorizations")
}

/// Regla aprendida de las asignaciones revisadas: dada la clasificación cruda
/// del ERP (y la primera palabra del nombre), a qué grupo va un producto
/// nuevo. Se regeneran con `pnpm categorization learn`; no viajan al push.
model CategorizationRule {
  id        Int      @id @default(autoincrement())
  /// 'lsg_w' | 'lsg' | 'g_w' | 'w' (de más a menos específica).
  kind      String
  /// Clave normalizada (minúsculas, sin acentos) según el `kind`.
  ruleKey   String   @map("rule_key")
  groupId   Int      @map("group_id")
  /// Productos de entrenamiento que respaldan la regla y su pureza (0–1).
  support   Int
  purity    Decimal  @db.Decimal(5, 4)
  createdAt DateTime @default(now()) @map("created_at")

  group ProductGroup @relation(fields: [groupId], references: [id])

  @@unique([kind, ruleKey])
  @@index([groupId])
  @@map("categorization_rules")
}

/// Producto del catálogo.
model Product {
  id Int @id @default(autoincrement())

  /// Hash surrogate estable del DWH (producto_key). Clave del upsert del sync.
  productoKey      String  @unique @map("producto_key")
  /// SKU del ERP. Indexado pero NO único: puede repetirse entre compañías.
  sku              String
  /// Nombre comercial (← descripcion del DWH).
  name             String
  /// Texto/código operativo del ERP (← sku_proveedor del DWH; no es contenido
  /// editorial ni un código de proveedor).
  shortDescription String? @map("short_description")

  /// Descripción editorial extensa para la ficha pública del producto.
  /// No la escribe el sync del DWH: se mantiene en el catálogo y se migra por
  /// lotes revisados (ver docs/product-content-migration.md).
  longDescription String? @map("long_description") @db.Text
  /// Título SEO editorial, normalmente de 50–65 caracteres.
  seoTitle        String? @map("seo_title")
  /// Descripción SEO editorial para metadatos y snippets, normalmente hasta
  /// 160 caracteres. No se deriva automáticamente del nombre del producto.
  seoDescription  String? @map("seo_description")

  // Clasificación cruda del DWH, conservada tal cual para trazabilidad.
  tipoItem String? @map("tipo_item")
  origen   String?
  linea    String?
  sublinea String?
  grupo    String?

  pesoKg        Decimal? @map("peso_kg") @db.Decimal(12, 3)
  factorEmpaque Decimal? @map("factor_empaque") @db.Decimal(12, 3)

  /// ← estado del DWH ('A' → true, 'I' → false). Los productos que dejan de
  /// venir en la extracción se desactivan (soft-deactivate), nunca se borran.
  active Boolean @default(true)

  supplierId     Int  @map("supplier_id")
  brandId        Int? @map("brand_id")
  manufacturerId Int? @map("manufacturer_id")
  /// Heredadas y sin uso: la categoría del producto vive en
  /// `product_categorizations`. Se conservan para no borrar columnas en la
  /// misma migración; se pueden retirar después.
  categoryId     Int? @map("category_id")
  subcategoryId  Int? @map("subcategory_id")

  // Precios: el DWH NO los provee; quedan nullable y el sync no los toca.
  price          Decimal?  @db.Decimal(14, 2)
  priceCurrency  String?   @default("COP") @map("price_currency")
  priceUpdatedAt DateTime? @map("price_updated_at")

  /// Fecha de creación reportada por el DWH (← fecha_creacion).
  dwhCreatedAt DateTime? @map("dwh_created_at")
  /// Última vez que el sync tocó (o confirmó) este producto.
  syncedAt     DateTime  @map("synced_at")
  /// Hash de los campos mapeados desde el DWH; permite saltar updates
  /// cuando la fila de origen no cambió.
  sourceHash   String    @map("source_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplier       Supplier               @relation(fields: [supplierId], references: [id])
  brand          Brand?                 @relation(fields: [brandId], references: [id])
  manufacturer   Manufacturer?          @relation(fields: [manufacturerId], references: [id])
  category       Category?              @relation(fields: [categoryId], references: [id])
  subcategory    Subcategory?           @relation(fields: [subcategoryId], references: [id])
  images         ProductImage[]
  favorites      Favorite[]
  orderListItems OrderListItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  categorization ProductCategorization?

  @@index([supplierId])
  @@index([brandId])
  @@index([active])
  @@index([sku])
  @@index([active, name, id])
  @@index([supplierId, active, name, id])
  @@index([brandId, active, name, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@map("products")
}

/// Imagen de producto. Los binarios viven en el bucket S3/MinIO ya
/// configurado; aquí solo se guarda la referencia. Se pueblan con
/// `pnpm images:ingest` (ver docs/product-images.md).
model ProductImage {
  id        Int @id @default(autoincrement())
  productId Int @map("product_id")

  /// Prefijo base del objeto en el bucket, sin extensión ni variante
  /// (p. ej. `products/{supplierCode}/{sku}/{hash8}`). Las tres variantes
  /// comparten este prefijo: `{objectKey}/thumb.webp`, `/card.webp`, `/full.webp`.
  objectKey String @map("object_key")

  /// URL pública servible; se mantiene apuntando a la variante `card` por
  /// compatibilidad con el contrato `imagenUrl` ya confirmado con la UI.
  url      String?
  thumbUrl String  @map("thumb_url")
  cardUrl  String  @map("card_url")
  fullUrl  String  @map("full_url")

  /// SHA-256 completo del archivo original. Si no cambia entre corridas de
  /// `images:ingest`, se salta el reproceso y la resubida (idempotencia).
  sourceChecksum String  @map("source_checksum")
  sourceFilename String? @map("source_filename")
  width          Int?
  height         Int?
  bytes          Int?

  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, position])
  @@index([productId])
  @@index([isPrimary, productId])
  @@map("product_images")
}

// =============================================================================
// FAVORITOS
//
// Primera superficie autenticada del catálogo (ver docs/favoritos.md).
// =============================================================================

/// Producto marcado como favorito por un usuario de la UI.
model Favorite {
  id String @id @default(cuid())

  /// Claim `sub` del JWT que emite la UI. Es un STRING OPACO: el catálogo no
  /// tiene acceso a la base `jdh_auth` y no puede (ni debe) resolverlo a una
  /// cuenta. No hay FK ni tabla de usuarios en esta base.
  userId String @map("user_id")

  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  /// `Cascade`: si un producto desaparece de la base, sus favoritos se van con
  /// él. El sync del DWH NO borra productos (los desactiva), así que en la
  /// práctica esto solo aplica a limpiezas manuales.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Hace idempotente el alta sin leer antes: repetir un PUT es un upsert que
  /// no falla.
  @@unique([userId, productId])
  /// Sirve el orden de la lista (`createdAt desc` dentro de un usuario).
  @@index([userId, createdAt])
  @@index([userId, createdAt, id])
  @@index([productId])
  @@map("favorites")
}

// =============================================================================
// LISTAS DE PEDIDO
//
// Borradores privados de cada usuario autenticado. El usuario es el `sub` del
// JWT y se conserva como string opaco, igual que en favoritos.
// =============================================================================

/// Lista de pedido/cotización de un usuario.
model OrderList {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderListItem[]

  @@index([userId, updatedAt])
  @@map("order_lists")
}

/// Producto y cantidad dentro de una lista. La clave compuesta hace idempotente
/// el PUT que agrega o actualiza una línea.
model OrderListItem {
  orderListId String   @map("order_list_id")
  productId   Int      @map("product_id")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderList OrderList @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([orderListId, productId])
  @@index([productId])
  @@index([orderListId, createdAt, productId])
  @@map("order_list_items")
}

// =============================================================================
// LISTAS DE PRECIOS
//
// Precios que llegan de fuera del DWH (hoy: la lista de empleados JDH que
// calcula la intranet). Tabla PROPIA, separada de `products`: el sync del DWH
// nunca la lee ni la escribe. Ver docs/product-prices.md.
// =============================================================================

/// Precio de un SKU dentro de una lista. La fila existe mientras el SKU venga
/// en la última carga de su lista; el cargador quita las que dejan de venir.
model ProductListPrice {
  id   Int    @id @default(autoincrement())
  /// Lista a la que pertenece (p. ej. 'empleados-jdh').
  list String
  /// SKU tal como lo envía la fuente.
  sku  String

  /// Producto del catálogo resuelto por SKU al cargar. `null` si el SKU no
  /// existe en el catálogo o si coincide con más de un producto (el SKU no es
  /// único entre compañías): en ese caso el precio no se muestra en ninguno.
  /// Se une por `producto_key` (estable frente al sync), sin FK: el producto
  /// puede no existir todavía.
  productoKey String? @map("producto_key")

  /// Unidad de inventario a la que corresponde el precio (p. ej. 'UNIDAD').
  inventoryUnit String?  @map("inventory_unit")
  /// Precio sin IVA, en pesos enteros.
  price         Decimal  @db.Decimal(14, 2)
  /// Porcentaje de IVA. 0 = sin IVA (se factura al 0 %); `null` = tasa
  /// desconocida en la fuente (precio con IVA = precio, «IVA por confirmar").
  /// Son cosas distintas y nunca se confunden.
  vatPct        Decimal? @map("vat_pct") @db.Decimal(5, 2)
  /// Etiqueta de la fuente ("IVA 19 %", "Sin IVA"); `null` si no la trae.
  vatLabel      String?  @map("vat_label")
  priceWithVat  Decimal  @map("price_with_vat") @db.Decimal(14, 2)
  currency      String   @default("COP")

  /// Cuándo generó la fuente el archivo y fecha de la foto de costos.
  generatedAt  DateTime @map("generated_at")
  snapshotDate DateTime @map("snapshot_date") @db.Date
  /// Última carga que confirmó la fila (cambie o no el precio).
  loadedAt     DateTime @map("loaded_at")
  createdAt    DateTime @default(now()) @map("created_at")
  /// Último cambio real de la fila (precio, IVA, unidad o producto resuelto).
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([list, sku])
  @@index([list, productoKey])
  @@map("product_list_prices")
}

// =============================================================================
// CARRITO Y PEDIDOS (empleados JDH)
//
// Un carrito por usuario (`sub` del JWT, string opaco como en favoritos). Los
// precios NO se guardan en el carrito: se calculan con la lista vigente en
// cada lectura; la línea solo recuerda el precio con el que se agregó para
// avisar si cambió. El pedido sí congela precio, IVA y totales. Ver
// docs/carrito-pedidos.md.
// =============================================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

model CartItem {
  cartId    String @map("cart_id")
  productId Int    @map("product_id")
  quantity  Int

  /// Precio sin IVA e IVA % de la lista cuando la línea se agregó o se
  /// cambió su cantidad por última vez. Solo para avisar de un cambio.
  addedPrice  Decimal? @map("added_price") @db.Decimal(14, 2)
  addedVatPct Decimal? @map("added_vat_pct") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

/// Pedido enviado. Inmutable salvo el estado del correo.
model Order {
  id     String @id @default(cuid())
  /// Consecutivo legible para el correo y la UI (PED-000123).
  number Int    @unique @default(autoincrement())
  userId String @map("user_id")

  /// Nombre y correo del empleado tal como los firma la UI (Entra).
  customerName  String  @map("customer_name")
  customerEmail String  @map("customer_email")
  note          String? @db.VarChar(500)

  /// Lista de precios con la que se calculó y fecha de su foto de costos.
  priceList    String   @map("price_list")
  snapshotDate DateTime @map("snapshot_date") @db.Date

  subtotal          Decimal @db.Decimal(14, 2)
  taxes             Decimal @db.Decimal(14, 2)
  total             Decimal @db.Decimal(14, 2)
  /// Hay líneas con IVA desconocido (no sumadas en `taxes`).
  hasUnconfirmedVat Boolean @default(false) @map("has_unconfirmed_vat")

  /// 'pendiente' | 'enviado' | 'error' | 'deshabilitado' (sin credenciales).
  emailStatus String    @default("pendiente") @map("email_status")
  emailError  String?   @map("email_error")
  emailSentAt DateTime? @map("email_sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  items OrderItem[]

  @@index([userId, createdAt])
  @@map("orders")
}

/// Línea del pedido con todo congelado (sku y nombre incluidos): el pedido no
/// depende de que el producto o la lista cambien después.
model OrderItem {
  orderId   String @map("order_id")
  productId Int    @map("product_id")
  sku       String
  name      String
  quantity  Int

  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  vatPct    Decimal? @map("vat_pct") @db.Decimal(5, 2)
  base      Decimal  @db.Decimal(14, 2)
  vat       Decimal  @db.Decimal(14, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

// =============================================================================
// CONTACTOS (formulario público de la home)
//
// Un registro por correo: si la persona vuelve a enviar el formulario se
// actualizan sus datos. Guarda la autorización de tratamiento de datos
// (Ley 1581) con fecha, IP y user agent. Ver docs/contact-leads.md.
// =============================================================================

model ContactLead {
  id                 Int     @id @default(autoincrement())
  nombre             String  @db.VarChar(120)
  /// En minúsculas.
  correo             String  @unique @db.VarChar(254)
  /// 10 dígitos, sin +57.
  celular            String  @db.VarChar(10)
  ciudad             String  @db.VarChar(80)
  /// 'NIT' | 'CC', o null si no dio identificación.
  tipoIdentificacion String? @map("tipo_identificacion") @db.VarChar(3)
  /// Solo dígitos; un NIT puede traer el DV tras un guion (900123456-7).
  identificacion     String? @db.VarChar(17)
  /// Formulario de origen (p. ej. 'home-newsletter').
  origen             String  @db.VarChar(40)

  /// Última vez que aceptó el tratamiento de datos.
  aceptaTratamientoAt DateTime @map("acepta_tratamiento_at") @db.Timestamptz(3)
  ip                  String?  @db.VarChar(45)
  userAgent           String?  @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("contact_leads")
}

/// Registro de cada ejecución de sincronización, para observabilidad.
model SyncRun {
  id          Int       @id @default(autoincrement())
  /// Qué se sincronizó (p. ej. 'products').
  type        String
  /// 'running' | 'success' | 'error'
  status      String
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  totalRead   Int?      @map("total_read")
  inserted    Int?
  updated     Int?
  deactivated Int?
  unchanged   Int?
  error       String?

  @@map("sync_runs")
}
