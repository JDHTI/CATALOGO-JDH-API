// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  // Prisma resuelve includes con JOIN en PostgreSQL y evita viajes por relación.
  previewFeatures = ["relationJoins"]
  provider     = "prisma-client"
  output       = "../generated/prisma"
  // NestJS compila a CommonJS; sin esto el cliente se genera como ESM
  // y falla al ejecutarse desde dist.
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// CATÁLOGO DE PRODUCTOS
//
// Los datos maestros provienen de la vista `consumo.productos` del DWH y se
// sincronizan con un full-extract + upsert idempotente (ver docs/products-sync.md).
// =============================================================================

/// Proveedor del catálogo.
///
/// OJO: "proveedor" aquí es una CLASIFICACIÓN comercial/de mercadeo del ERP
/// (criterio mayor t106), NO una identidad jurídica: no existe NIT ni datos
/// fiscales. Es el criterio de agrupación de productos por proveedor que usa
/// el catálogo (~645 valores distintos).
model Supplier {
  id            Int      @id @default(autoincrement())
  /// Código de la clasificación en el ERP (← cod_proveedor del DWH).
  code          String   @unique
  /// Nombre de la clasificación (← proveedor del DWH).
  name          String
  active        Boolean  @default(true)
  /// Logo comercial: key del objeto en el bucket y URL absoluta servible.
  /// El sync del DWH no los toca; se cargan aparte y quedan null hasta entonces.
  logoObjectKey String?  @map("logo_object_key")
  logoUrl       String?  @map("logo_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("suppliers")
}

/// Fabricante (← fabricante del DWH, texto normalizado con trim).
model Manufacturer {
  id   Int    @id @default(autoincrement())
  name String @unique

  products Product[]

  @@map("manufacturers")
}

/// Marca (← marca del DWH, texto normalizado con trim).
model Brand {
  id            Int     @id @default(autoincrement())
  name          String  @unique
  /// Logo comercial: key del objeto en el bucket y URL absoluta servible.
  /// El sync del DWH no los toca; se cargan aparte y quedan null hasta entonces.
  logoObjectKey String? @map("logo_object_key")
  logoUrl       String? @map("logo_url")

  products Product[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "brands_name_trgm_idx")
  @@map("brands")
}

/// Categoría del catálogo. Solo esquema base: la categorización de productos
/// se hará en una fase posterior (el sync NO la puebla todavía).
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

/// Subcategoría, única por nombre dentro de su categoría.
model Subcategory {
  id         Int    @id @default(autoincrement())
  name       String
  categoryId Int    @map("category_id")

  category Category  @relation(fields: [categoryId], references: [id])
  products Product[]

  @@unique([name, categoryId])
  @@map("subcategories")
}

/// Producto del catálogo.
model Product {
  id Int @id @default(autoincrement())

  /// Hash surrogate estable del DWH (producto_key). Clave del upsert del sync.
  productoKey      String  @unique @map("producto_key")
  /// SKU del ERP. Indexado pero NO único: puede repetirse entre compañías.
  sku              String
  /// Nombre comercial (← descripcion del DWH).
  name             String
  /// Texto/código operativo del ERP (← sku_proveedor del DWH; no es contenido
  /// editorial ni un código de proveedor).
  shortDescription String? @map("short_description")

  /// Descripción editorial extensa para la ficha pública del producto.
  /// No la escribe el sync del DWH: se mantiene en el catálogo y se migra por
  /// lotes revisados (ver docs/product-content-migration.md).
  longDescription String? @map("long_description") @db.Text
  /// Título SEO editorial, normalmente de 50–65 caracteres.
  seoTitle       String? @map("seo_title")
  /// Descripción SEO editorial para metadatos y snippets, normalmente hasta
  /// 160 caracteres. No se deriva automáticamente del nombre del producto.
  seoDescription String? @map("seo_description")

  // Clasificación cruda del DWH, conservada tal cual para trazabilidad.
  tipoItem String? @map("tipo_item")
  origen   String?
  linea    String?
  sublinea String?
  grupo    String?

  pesoKg        Decimal? @map("peso_kg") @db.Decimal(12, 3)
  factorEmpaque Decimal? @map("factor_empaque") @db.Decimal(12, 3)

  /// ← estado del DWH ('A' → true, 'I' → false). Los productos que dejan de
  /// venir en la extracción se desactivan (soft-deactivate), nunca se borran.
  active Boolean @default(true)

  supplierId     Int  @map("supplier_id")
  brandId        Int? @map("brand_id")
  manufacturerId Int? @map("manufacturer_id")
  categoryId     Int? @map("category_id")
  subcategoryId  Int? @map("subcategory_id")

  // Precios: el DWH NO los provee; quedan nullable y el sync no los toca.
  price          Decimal?  @db.Decimal(14, 2)
  priceCurrency  String?   @default("COP") @map("price_currency")
  priceUpdatedAt DateTime? @map("price_updated_at")

  /// Fecha de creación reportada por el DWH (← fecha_creacion).
  dwhCreatedAt DateTime? @map("dwh_created_at")
  /// Última vez que el sync tocó (o confirmó) este producto.
  syncedAt     DateTime  @map("synced_at")
  /// Hash de los campos mapeados desde el DWH; permite saltar updates
  /// cuando la fila de origen no cambió.
  sourceHash   String    @map("source_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  brand        Brand?         @relation(fields: [brandId], references: [id])
  manufacturer Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  category     Category?      @relation(fields: [categoryId], references: [id])
  subcategory  Subcategory?   @relation(fields: [subcategoryId], references: [id])
  images       ProductImage[]
  favorites    Favorite[]
  orderListItems OrderListItem[]

  @@index([supplierId])
  @@index([brandId])
  @@index([active])
  @@index([sku])
  @@index([active, name, id])
  @@index([supplierId, active, name, id])
  @@index([brandId, active, name, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@map("products")
}

/// Imagen de producto. Los binarios viven en el bucket S3/MinIO ya
/// configurado; aquí solo se guarda la referencia. Se pueblan con
/// `pnpm images:ingest` (ver docs/product-images.md).
model ProductImage {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")

  /// Prefijo base del objeto en el bucket, sin extensión ni variante
  /// (p. ej. `products/{supplierCode}/{sku}/{hash8}`). Las tres variantes
  /// comparten este prefijo: `{objectKey}/thumb.webp`, `/card.webp`, `/full.webp`.
  objectKey String @map("object_key")

  /// URL pública servible; se mantiene apuntando a la variante `card` por
  /// compatibilidad con el contrato `imagenUrl` ya confirmado con la UI.
  url      String?
  thumbUrl String  @map("thumb_url")
  cardUrl  String  @map("card_url")
  fullUrl  String  @map("full_url")

  /// SHA-256 completo del archivo original. Si no cambia entre corridas de
  /// `images:ingest`, se salta el reproceso y la resubida (idempotencia).
  sourceChecksum String  @map("source_checksum")
  sourceFilename String? @map("source_filename")
  width          Int?
  height         Int?
  bytes          Int?

  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, position])
  @@index([productId])
  @@index([isPrimary, productId])
  @@map("product_images")
}

// =============================================================================
// FAVORITOS
//
// Primera superficie autenticada del catálogo (ver docs/favoritos.md).
// =============================================================================

/// Producto marcado como favorito por un usuario de la UI.
model Favorite {
  id String @id @default(cuid())

  /// Claim `sub` del JWT que emite la UI. Es un STRING OPACO: el catálogo no
  /// tiene acceso a la base `jdh_auth` y no puede (ni debe) resolverlo a una
  /// cuenta. No hay FK ni tabla de usuarios en esta base.
  userId String @map("user_id")

  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  /// `Cascade`: si un producto desaparece de la base, sus favoritos se van con
  /// él. El sync del DWH NO borra productos (los desactiva), así que en la
  /// práctica esto solo aplica a limpiezas manuales.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Hace idempotente el alta sin leer antes: repetir un PUT es un upsert que
  /// no falla.
  @@unique([userId, productId])
  /// Sirve el orden de la lista (`createdAt desc` dentro de un usuario).
  @@index([userId, createdAt])
  @@index([userId, createdAt, id])
  @@index([productId])
  @@map("favorites")
}

// =============================================================================
// LISTAS DE PEDIDO
//
// Borradores privados de cada usuario autenticado. El usuario es el `sub` del
// JWT y se conserva como string opaco, igual que en favoritos.
// =============================================================================

/// Lista de pedido/cotización de un usuario.
model OrderList {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderListItem[]

  @@index([userId, updatedAt])
  @@map("order_lists")
}

/// Producto y cantidad dentro de una lista. La clave compuesta hace idempotente
/// el PUT que agrega o actualiza una línea.
model OrderListItem {
  orderListId String   @map("order_list_id")
  productId   Int      @map("product_id")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderList OrderList @relation(fields: [orderListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([orderListId, productId])
  @@index([productId])
  @@index([orderListId, createdAt, productId])
  @@map("order_list_items")
}

/// Registro de cada ejecución de sincronización, para observabilidad.
model SyncRun {
  id          Int       @id @default(autoincrement())
  /// Qué se sincronizó (p. ej. 'products').
  type        String
  /// 'running' | 'success' | 'error'
  status      String
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  totalRead   Int?      @map("total_read")
  inserted    Int?
  updated     Int?
  deactivated Int?
  unchanged   Int?
  error       String?

  @@map("sync_runs")
}
